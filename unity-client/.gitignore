# Unity — dự án Unity thật (Assets/, Packages/, ProjectSettings/)
#
# QUAN TRỌNG: file này nằm TRONG unity-client/, nên mẫu đường dẫn phải tính từ
# đây. Bản trước ghi "unity-client/[Ll]ibrary/" (tính từ gốc repo) nên KHÔNG
# khớp gì — Library/ (1,7 GB) và Builds/ từng hiện ra trong git status.
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

*.sln
*.unityproj
*.user
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vs/
.idea/
.vscode/

Assets/AssetStoreTools*
Assets/Plugins/Editor/JetBrains*
Assets/StreamingAssets/aa.meta
Assets/StreamingAssets/aa/*
Assets/AddressableAssetsData/*.bin
Assets/AddressableAssetsData/*/*.bin
Assets/AddressableAssetsData/*/*.dat

# Bee / IL2CPP cache
[Bb]ee/
*.wasm
*.data

# Build output
*.apk
*.aab
*.unitypackage
*.app

# .NET domain build output
**/bin/
**/obj/
# Nhưng GIỮ các .csproj dùng để test bằng dotnet/CI (không phải Unity sinh).
!UnityStub/*.csproj
!ArtemisDomain/*.csproj
!ArtemisDomain.Tests/*.csproj
tools/unity-parity/.dotnet/
dotnet8/
